<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Or leave it and push a theme instead: tools/theme.sh themes/<name> puts a config.json (same keys, see
  themes/README.md) and an optional wallpaper on the TV, and the launcher overlays it at start.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>net.fptplay.ottbox</item>
        <item>vn.vtv.vtvgotv</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
        <!-- Xiaomi Mi TV 3 (China): Chinese-only content apps, Xiaomi tools and a leftover launcher. -->
        <item>com.gitv.times</item>
        <item>com.sohuott.tv.vod.xiaomi</item>
        <item>com.xiaomi.mitv.shop.tvshop</item>
        <item>com.mitv.shoplugin</item>
        <item>com.mitv.appstore.component.land</item>
        <item>com.mitv.videoplayer</item>
        <item>com.mitv.mivideoplayer</item>
        <item>com.mitv.codec.update</item>
        <item>com.mitv.care</item>
        <item>com.xm.webcontent</item>
        <item>com.miui.tv.analytics</item>
        <item>com.cmcm.cleanmaster.tv</item>
        <item>com.altusapps.firedtvlauncher</item>
        <!-- Play Store 5.4 without Google Play services: it opens and closes at once on this TV. -->
        <item>com.android.vending</item>
    </string-array>

    <!-- Also tile installed apps that only have a phone launcher entry, not an Android TV one. Needed on
         TVs that are not Android TV, such as Xiaomi's MIUI TV sets (Mi TV 3, Android 5.1). -->
    <bool name="include_phone_apps">true</bool>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit.
         Xiaomi MIUI TV: com.xiaomi.mitv.tvplayer with the action below (analogue tuner). -->
    <string name="live_tv_package" translatable="false">com.xiaomi.mitv.tvplayer</string>

    <!-- Some TVs give their Live TV app no leanback entry point at all, so `live_tv_package` above
         resolves to nothing (TCL Android TV 9 on China-market sets is one). This action is then sent
         to that package instead, and the app starts normally. Leave empty to omit. -->
    <string name="live_tv_action" translatable="false">com.xiaomi.mitv.tvplayer.ATV_PLAY</string>

    <!-- TVs with no TvInputManager whose own player switches to a fixed input given as an int extra. Each
         "label|id" entry in source_list becomes a row of the Inputs menu that sends source_intent_action
         with source_intent_extra = id. Xiaomi MIUI TV (Mi TV 3, Android 5.1): com.xiaomi.mitv.tvplayer.EXTSRC_PLAY
         with "input", ids from mitv.tv.SourceManager (HDMI 1-3 = 23-25, AV = 2). Empty list: no rows. -->
    <string name="source_intent_action" translatable="false">com.xiaomi.mitv.tvplayer.EXTSRC_PLAY</string>
    <string name="source_intent_extra" translatable="false">input</string>
    <string-array name="source_list" translatable="false">
        <item>HDMI 1|23</item>
        <item>HDMI 2|24</item>
        <item>HDMI 3|25</item>
        <item>AV|2</item>
    </string-array>

    <!-- When the TV is switched on, open the first of these inputs that has a device connected, in this order,
         e.g. 23,24,25 for HDMI 1, then 2, then 3 (ids as in source_list; sent with source_intent_action).
         Needs Xiaomi's TV API to see which ports are connected (MIUI TV sets). Empty: always start on Home. -->
    <string name="power_on_inputs" translatable="false">23,24,25</string>

    <!-- The TV maker's own settings app (picture, sound, debugging switches), offered as the last row of the
         Inputs menu. Xiaomi MIUI TV: com.xiaomi.mitv.settings.SETTINGS. Leave empty to omit. -->
    <string name="tv_settings_action" translatable="false">com.xiaomi.mitv.settings.SETTINGS</string>

    <!-- The TV's screen mirroring app (AirPlay from an iPhone, Miracast and casting from Android), as
         package/.Activity, offered in the Inputs menu. Xiaomi MIUI TV: com.xiaomi.mitv.smartshare/.MainActivity.
         Leave empty to omit. -->
    <string name="cast_component" translatable="false">com.xiaomi.mitv.smartshare/.MainActivity</string>

    <!-- Weather next to the clock, from Open-Meteo (no key, no account): "latitude,longitude" of your city,
         e.g. 21.03,105.85 for Hanoi. Fetched every 30 minutes while Home is open. Leave empty to omit;
         the launcher then makes no network requests. -->
    <string name="weather_location" translatable="false">21.03,105.85</string>

    <!-- TVs with no TvInputManager have no HDMI list to read, but their own source-selection panel
         still switches inputs (TCL Android TV 9 again). When nothing could be listed, the Inputs menu
         offers one row that starts this service: component first, then action. Leave empty to omit. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>

    <!-- Inputs menu: HDMI and AV rows normally open with ACTION_VIEW on the input's channel URI, which the
         Live TV app handles. Where nothing answers that, this action is sent with the same URI instead
         (XGIMI projectors: com.xgimi.action.hdmiPlayer). Leave empty to omit. -->
    <string name="input_action" translatable="false"></string>

    <!-- Show the Solar Hijri (Shamsi) date used in Iran and Afghanistan, e.g. "27 Mehr 1405", above the
         Gregorian date. -->
    <bool name="shamsi_date">false</bool>
    <!-- Optional VPN app the network pill opens (hold the pill for Wi-Fi settings), e.g. the package of the
         VPN you use. Empty: the pill opens Wi-Fi settings. The green VPN badge shows for any VPN either way;
         with an app set here, a red "VPN off" badge also shows while no VPN is up. -->
    <string name="vpn_app" translatable="false"></string>
    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. -->
    <integer name="rows_below_dock">0</integer>

    <!-- Tiles per row in the grid; the dock always has this many slots. Tiles are 180dp wide at 4 columns and
         shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a 1080p TV). -->
    <integer name="columns">4</integer>

    <!-- "Default home" tile that opens Android's home-screen picker, for TVs whose settings have one
         (most Android TVs don't; the tile only appears when the page exists). Off by default. -->
    <bool name="show_home_settings_shortcut">false</bool>

    <!-- Module cards: an app that declares a card (docs/specs/card.md) can stand in for its tile with its own
         label, caption and glow colour, once you answer Show on the prompt. false: never look for cards or ask. -->
    <bool name="module_cards">true</bool>
</resources>
